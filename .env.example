# Resend (server-only — never use VITE_ prefix)
RESEND_API_KEY=re_xxxxxxxx

# E-mail interno recebido pela equipe comercial
CONTACT_TO_EMAIL=contato@studiodev.com.br

# Remetente verificado no Resend (subdomínio updates.studiodev.com.br)
CONTACT_FROM_EMAIL=contato@updates.studiodev.com.br

# Cloudflare Turnstile
# Client (Vite) — safe to expose
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Server only — never use VITE_ prefix
# Dummy always-pass keys for local: https://developers.cloudflare.com/turnstile/troubleshooting/testing/
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
